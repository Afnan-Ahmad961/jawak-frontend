# Django REST API host (server-only; the browser never sees this).
# The BFF forwards to ${DJANGO_API_URL}/api/v1/*
DJANGO_API_URL=http://localhost:8000

# Google OAuth client id used by Google Identity Services on the login page.
# Public by design (NEXT_PUBLIC_*). Server never needs a Google secret because
# we exchange the Google *access token* at Django, not an auth code.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Origin that serves uploaded media (S3/CDN) in production, e.g.
# https://media.example.com. Used to allow-list next/image remote hosts.
# In dev, media is served by DJANGO_API_URL, so this can be left blank.
NEXT_PUBLIC_MEDIA_URL=
